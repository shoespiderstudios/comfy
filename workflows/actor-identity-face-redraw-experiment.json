ift."],"color":"#432","bgcolor":"#653"}],"links":[[1,5,0,7,0,"CLIP"],[2,7,0,8,0,"CONDITIONING"],[3,2,0,9,0,"IMAGE"],[4,9,0,10,0,"IMAGE"],[5,6,0,10,1,"VAE"],[6,7,0,11,0,"CONDITIONING"],[7,8,0,12,0,"CONDITIONING"],[8,10,0,11,1,"LATENT"],[9,10,0,12,1,"LATENT"],[10,3,0,14,0,"IMAGE"],[11,4,0,14,1,"MODEL"],[12,5,0,14,2,"CLIP"],[13,6,0,14,3,"VAE"],[14,11,0,14,4,"CONDITIONING"],[15,12,0,14,5,"CONDITIONING"],[16,13,0,14,6,"BBOX_DETECTOR"],[17,14,0,16,0,"IMAGE"],[18,14,0,20,0,"IMAGE"],[19,14,1,17,0,"IMAGE"],[20,14,3,18,0,"MASK"],[21,18,0,19,0,"IMAGE"],[22,3,0,15,0,"IMAGE"],[23,9,0,21,0,"IMAGE"]],"groups":[],"config":{},"extra":{"frontendVersion":"1.47.11","workflowRendererVersion":"LG","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true,"ds":{"scale":1.2666661150000007,"offset":[1155.811416448489,777.4603022248046]}},"version":0.4}
